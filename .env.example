# ── apps/web/.env.local 로 복사해서 채운다 ──────────────────────────────

# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # 서버 전용. NEXT_PUBLIC_ 절대 붙이지 말 것

# Prisma → packages/db/.env 에도 같은 값 필요 (migrate가 cwd에서 읽음)
# Dashboard → Project Settings → Database → Connection string
DATABASE_URL=                       # Transaction pooler(6543) + ?pgbouncer=true&connection_limit=1
DIRECT_URL=                         # Direct(5432), migrate 전용

# 사용자 API 키 / GitHub 토큰 암호화 (AES-256-GCM). 32바이트를 base64 로:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# 자체 서버 러너 (apps/runner)
RUNNER_URL=http://localhost:4000
RUNNER_SECRET=

# 팀원 초대 메일 (resend.com)
RESEND_API_KEY=
