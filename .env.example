# ── apps/web/.env.local 로 복사해서 채운다 ──────────────────────────────

# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # 서버 전용. NEXT_PUBLIC_ 절대 붙이지 말 것

# Prisma → packages/db/.env 에도 같은 값 필요 (migrate가 cwd에서 읽음)
# Dashboard 상단 Connect → ORM → Prisma 에 두 줄 다 나온다.
# 둘 다 pooler 호스트를 쓴다. db.<ref>.supabase.co 로 직접 붙는 경로는 IPv6 전용이라
# 로컬·CI 에서 자주 실패한다 — Supabase 도 이제 pooler 쪽을 안내한다.
DATABASE_URL=                       # transaction 모드 pooler(6543). ?pgbouncer=true&connection_limit=1
DIRECT_URL=                         # session 모드 pooler(5432). migrate 전용

# 비밀값 암호화 (AES-256-GCM). 32바이트를 base64 로:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 채팅 대화 제목·본문, Slack 봇 토큰, Discord 웹훅 URL 을 암호화해 저장하는 데 쓴다
# (lib/crypto/secret.ts). 한 번 정하면 바꾸지 않는다 — 바꾸면 이미 저장한 암호문을 못 읽는다.
ENCRYPTION_KEY=

# ── AI 엔진 (Codex) ────────────────────────────────────────────────────
# 사용자 키가 아니라 우리 키다. 사용자는 프로바이더를 고르지도, 키를 넣지도
# 않는다 — Dante 가 OpenAI 와 직접 계약하고 이 키 하나로 부른다.
# 없으면 채팅·생성 첫 호출에서 바로 터진다 (lib/ai/chat-model.ts).
OPENAI_API_KEY=

# 플랜(ai_plans)이 없는 사용자 1명당 한 달 AI 원가 상한(USD). 플랜이 붙은 사용자는
# ai_plans.monthly_limit_usd 를 쓴다. 토큰 수나 호출 횟수가 아니라 달러다 —
# 모델이 바뀌어도 "한 달에 $N" 의 뜻이 그대로다 (lib/ai/pricing.ts 참고).
# 넘으면 그 사용자의 호출을 막는다(경고만 하지 않는다). 초기화 시각은 매월 1일
# 00:00 Asia/Seoul 이고, 사용량 화면과 같은 구간을 쓴다 (lib/ai/billing-period.ts).
# 값이 없거나 음수면 AI 호출이 전부 막힌다 — 빼먹은 설정이 조용히 무제한이 되면
# 막으려던 상황이 그대로 벌어지기 때문이다 (lib/ai/budget.ts).
# 0 = AI 끄기.
#
# 5 는 사용자당 월 250턴쯤이다(파일 컨텍스트 붙인 채팅 한 턴 ≈ $0.02). 실제 사용
# 패턴이 쌓이기 전이라 보수적으로 잡았다 — 환경변수라 재배포 없이 올릴 수 있다.
AI_MONTHLY_BUDGET_USD=5

# ── GitHub App (레포 연결) ─────────────────────────────────────────────
# 로그인용 Supabase GitHub OAuth 와는 별개다.
#   로그인   = "너 누구야"        → Supabase Auth
#   레포 연결 = "어떤 레포 볼래" → 아래 GitHub App
# App 을 따로 쓰는 이유: 사용자가 레포를 골라서 설치할 수 있고, 우리가 사용자
# 토큰을 저장하지 않아도 된다(설치 토큰을 private key 로 1시간짜리씩 발급).
#
# 등록: https://github.com/settings/apps/new  (PR 테스트에 필요한 권한·이벤트는 docs/notifications-github.md §12)
GITHUB_APP_ID=                      # App 등록 후 General 최상단 숫자
GITHUB_APP_SLUG=                    # 설치 URL 에 쓰는 이름. github.com/apps/<여기>
GITHUB_APP_PRIVATE_KEY=             # 받은 .pem 전체. 개행을 \n 으로 바꿔 한 줄로
GITHUB_APP_WEBHOOK_SECRET=          # App 설정의 Webhook secret. 아래 참고

# 웹훅(연결 끊김 감지, PR 테스트)을 로컬에서 받으려면:
#   1) https://smee.io → Start a new channel → 나온 URL 을 복사한다
#      (GitHub 은 localhost 에 못 붙으니 공개 주소가 하나 필요하다. ngrok·cloudflared
#       같은 터널도 되지만 smee 는 가입도 설치도 없다)
#   2) App 설정 → Webhook:
#        Active   체크
#        URL      1) 에서 복사한 smee 주소
#        Secret   난수 하나. 위 GITHUB_APP_WEBHOOK_SECRET 에 같은 값을 적는다
#   3) App 설정 → Subscribe to events: Repository, Pull request, Check run 을 켠다
#      (installation, installation_repositories 는 App 이면 항상 온다)
#   4) 로컬에서 smee → 우리 라우트로 흘려보낸다:
#      npx smee-client --url <smee 주소> \
#        --target http://localhost:3000/api/github/webhook
#
#   gh CLI 의 `gh webhook forward` 는 쓸 수 없다. 레포·조직 웹훅 전용이라
#   App 단위 이벤트(installation 계열)가 오지 않는다 — 우리가 필요한 게 그거다.

# 테스트 실행 (Vercel Sandbox, packages/sandbox). ADR-0002.
# Vercel 에 배포하면 OIDC 로 자동 인증되므로 운영에는 아무것도 넣지 않는다 — 넣으면 OIDC 대신 이 토큰을 쓴다.
# 로컬은 `vercel env pull` 이 넣는 VERCEL_OIDC_TOKEN 으로 된다. 그게 안 되면(팀 뷰어 등)
# 배포 팀 범위로 발급한 Access Token 과 그 팀의 Team ID·Project ID 셋을 다 채운다.
# 셋 다 비어 있으면 PR 작업은 테스트 생성까지만 하고 실행은 건너뛴다.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
# 샌드박스 실행은 팀마다 하나씩, 생성과 다른 함수에서 돈다. 차례가 오면 서버가 자기 자신의
# /api/internal/pr-test-run 을 부른다(서명 열쇠는 GITHUB_APP_WEBHOOK_SECRET).
# 비우면 Vercel 에서는 NEXT_PUBLIC_APP_URL, 로컬에서는 http://localhost:$PORT(기본 3000) 로 부른다.
# 로컬을 다른 포트로 띄우면 적는다. 예: http://localhost:3100
INTERNAL_APP_URL=

# 심사용 데모 계정 (lib/auth/demo.ts, app/auth/actions.ts). Supabase Auth 에 이메일·비밀번호로 만든
# 계정을 적는다. 둘 다 있어야 로그인 화면에 Preview 버튼이 뜨고, 비우면 버튼이 없다.
# 이 계정은 되돌릴 수 없거나 밖으로 나가는 액션이 서버에서 막힌다.
DEMO_EMAIL=
DEMO_PASSWORD=

# 팀원 초대 메일 (resend.com)
RESEND_API_KEY=
TEAM_INVITE_FROM_EMAIL=             # 예: Dante <team@dante.dev>. 비우면 Resend onboarding 주소(계정 주인에게만 발송)
NEXT_PUBLIC_APP_URL=                # 메일·코멘트 링크의 절대 주소. 비우면 초대 링크는 요청 호스트로 만든다

# Slack 알림 (docs/notifications-slack.md §13). https://api.slack.com/apps 에서 앱을 만든다.
#   OAuth & Permissions → Redirect URLs: <앱 주소>/api/slack/callback
#   Bot Token Scopes: chat:write, chat:write.public, channels:read, groups:read
# 배포 환경마다 redirect URL 이 달라서 개발용·운영용 앱을 따로 두는 편이 낫다.
# 비우면 팀 설정의 Slack 화면이 연결 버튼 대신 안내를 띄운다.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Slack 은 redirect URL 을 https 로만 받는다. 로컬은 터널(ngrok·cloudflared)로 받는데,
# Next 가 요청을 localhost 로 보면 redirect URL 이 어긋난다. 그때 터널 주소로 못박는다.
# 예: https://xxxx.ngrok-free.app/api/slack/callback
SLACK_REDIRECT_URL=
