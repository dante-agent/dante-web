// 데이터 모델. "GitHub 레포 연결" + "테스트 생성·실행" 두 갈래다.
//
// 뒤쪽(Component → TestFile → TestFileVersion → TestRun)은 아직 생성 기능이
// 없는 상태에서 runner 를 붙이려고 먼저 넣은 것이다. 실제 생성 로직이 들어오면
// 필드가 늘 수 있다. 지금은 runner 가 "무엇을 어디서 돌릴지" 알아내는 데
// 필요한 최소한만 있다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // 풀러(6543) + ?pgbouncer=true&connection_limit=1
  directUrl = env("DIRECT_URL") // 직접(5432), migrate 전용
}

/// Supabase 의 auth.users 를 public 스키마에서 참조하기 위한 미러.
///
/// auth.users 에 직접 외래키를 걸지 않는 이유:
///   - auth 스키마는 Supabase 가 관리한다. 우리 마이그레이션이 건드리면 충돌한다.
///   - Prisma 는 public 스키마만 본다(AGENTS.md).
/// 그래서 id 에 auth.users.id 와 같은 UUID 를 넣고, 채우는 건 앱 코드가 한다
/// (로그인 후 첫 요청에서 upsert).
model User {
  /// = auth.users.id
  id          String   @id @db.Uuid
  email       String?
  /// GitHub 로그인 핸들. 설치가 이 사용자 것인지 대조할 때 쓴다.
  githubLogin String?  @map("github_login")
  /// = GitHub 사용자 숫자 ID (auth 의 provider_id)
  githubId    BigInt?  @map("github_id")
  /// 프로바이더가 준 프로필 이미지 URL (GitHub avatar_url / Google picture).
  /// 헤더는 로그인 세션의 값을 그대로 쓰지만, 세션 없이 사용자를 그려야 하는
  /// 자리(다른 사람이 보는 화면 등)를 위해 로그인마다 여기에 복사해둔다.
  avatarUrl   String?  @map("avatar_url")
  /// AI 월 한도를 정하는 플랜. null 이면 환경변수 AI_MONTHLY_BUDGET_USD 가 기본 한도다
  /// (apps/web/src/lib/ai/budget.ts). 가입할 때 플랜을 고르는 흐름이 없어서 대부분 null 이다.
  aiPlanId    String?  @map("ai_plan_id") @db.Uuid
  /// 생성 품질 기본값. "standard" | "deep" (apps/web/src/lib/ai/quality.ts).
  /// 문자열인 이유는 testFramework 와 같다 — 단계가 늘 때마다 마이그레이션하지 않으려고.
  /// 권한에 쓰이는 값이 아니라서 모르는 값이 들어와도 standard 로 읽으면 된다.
  aiQuality   String   @default("standard") @map("ai_quality")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  /// 이 사람이 연결한 설치·만든 프로젝트. 주인은 팀이라 권한과는 무관한 기록이다.
  createdInstallations GithubInstallation[]
  createdProjects      Project[]
  extensionAuthCodes ExtensionAuthCode[]
  extensionTokens    ExtensionToken[]
  aiUsage            AiUsage[]
  chatConversations  ChatConversation[]
  teamMemberships    TeamMember[]
  sentTeamInvites    TeamInvite[]
  slackInstallations SlackInstallation[]
  /// 가입할 때 자동으로 만든 "내 팀". 사용자당 하나다(Team.personalForUserId 가 unique).
  personalTeam       Team?                @relation("PersonalTeam")
  /// Restrict: 쓰는 사람이 있는 플랜을 지우면 그 사람들 한도가 조용히 기본값으로
  /// 바뀐다. 한도가 느슨해질 수도 있는 변경이라 DB 가 먼저 막게 한다.
  aiPlan             AiPlan?              @relation(fields: [aiPlanId], references: [id], onDelete: Restrict)

  @@map("users")
}

/// AI 월 한도를 묶은 플랜.
///
/// 한도를 User 컬럼 하나로 두지 않은 이유: 사람마다 숫자를 따로 적으면 "이 사람은 어떤
/// 조건으로 쓰나"에 이름이 없다. 화면에 플랜 이름을 보여줄 수 있어야 하고, 나중에 결제를
/// 붙이면 결제 상품이 붙을 자리도 여기다. 결제는 아직 없어서 플랜은 운영자가 직접 배정한다.
///
/// 크레딧·이월 개념은 없다. 한도는 매달 billing-period.ts 의 구간마다 새로 센다.
model AiPlan {
  id              String   @id @default(uuid()) @db.Uuid
  /// 화면에 그대로 나가는 이름. 예: "Beta", "Team".
  name            String   @unique
  /// 한 달 원가 상한(USD). AiUsage.costUsd 와 같은 자릿수라 합계와 비교할 때 반올림이 끼지 않는다.
  /// 0 = 이 플랜은 AI 를 쓸 수 없다.
  monthlyLimitUsd Decimal  @map("monthly_limit_usd") @db.Decimal(12, 6)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("ai_plans")
}

/// 데이터의 주인. 프로젝트와 GitHub 설치는 사람이 아니라 팀에 붙는다.
///
/// 가입하면 개인 팀이 하나 생긴다(Vercel·Supabase 방식). "항상 팀이 있다"를 전제로
/// 짜야 조회·권한 검사가 사람 소유/팀 소유 두 갈래로 나뉘지 않는다.
///
/// 이관 중이라 Project·GithubInstallation 의 userId 는 아직 남아 있다. 조회를 멤버십
/// 기준으로 바꾼 뒤(feat/team-access) 지운다.
model Team {
  id                String   @id @default(uuid()) @db.Uuid
  /// 화면에 보이는 이름. 개인 팀은 GitHub 핸들(없으면 이메일 앞부분)로 시작한다.
  name              String
  /// 개인 팀이면 그 주인. 일반 팀은 null.
  ///
  /// Boolean 이 아니라 사용자 id 를 두는 이유: unique 로 "사용자당 개인 팀 하나"를
  /// DB 가 보장하고, 로그인마다 upsert 로 멱등하게 만들 수 있다. 계정을 지울 때
  /// 지워야 할 팀을 찾는 열쇠이기도 하다.
  personalForUserId String?  @unique @map("personal_for_user_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  /// Restrict: 개인 팀 주인을 지우는 흐름은 계정 삭제가 따로 정한다. 사용자 행이
  /// 지워지면서 팀과 프로젝트가 조용히 cascade 되지 않게 DB 가 먼저 막는다.
  personalFor   User?                @relation("PersonalTeam", fields: [personalForUserId], references: [id], onDelete: Restrict)
  members       TeamMember[]
  invites       TeamInvite[]
  projects      Project[]
  installations GithubInstallation[]
  slack         SlackInstallation?

  @@map("teams")
}

/// owner 만 할 수 있는 일: 프로젝트 삭제, 멤버 초대·제거·역할 변경, 팀 설정, 팀 삭제.
/// 프로젝트 생성과 설정은 member 도 한다.
///
/// 문자열이 아니라 enum 인 이유: 역할은 권한 검사에 바로 쓰인다. 오타 난 값이 들어가면
/// 어떤 검사에도 걸리지 않는 역할이 생긴다. 값을 늘릴 때(admin)는 ADD VALUE 한 줄이다.
enum TeamRole {
  owner
  member

  @@map("team_role")
}

/// 팀 멤버십. 권한 검사는 전부 이 표를 본다(lib/teams/access.ts).
///
/// 캐시하지 않는다. 팀에서 빠진 사람의 익스텐션 토큰이 그 즉시 막혀야 한다.
model TeamMember {
  teamId    String   @map("team_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      TeamRole @default(member)
  createdAt DateTime @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  /// "이 사용자가 속한 팀" 이 가장 잦은 질문이다(PK 는 teamId 가 앞이라 못 쓴다).
  @@index([userId])
  @@map("team_members")
}

/// 팀 초대. owner 가 이메일로 보내고, 링크를 연 사람이 로그인한 계정으로 수락한다.
///
/// 받는 주소와 수락하는 계정이 달라도 된다. GitHub 로 가입한 사람의 이메일이 회사 주소와
/// 다른 경우가 흔하다. 대신 링크는 1회용이고(수락하면 행을 지운다) 7일 뒤 죽는다.
/// 규칙은 lib/teams/invites.ts.
model TeamInvite {
  id          String   @id @default(uuid()) @db.Uuid
  teamId      String   @map("team_id") @db.Uuid
  /// 소문자로 접은 주소(invite-rules.ts 의 normalizeEmail).
  email       String
  /// 링크 토큰의 sha256. 원문은 메일에만 있다.
  tokenHash   String   @unique @map("token_hash")
  /// 보낸 owner. 그 사람이 계정을 지워도 초대는 살아 있게 SetNull.
  invitedById String?  @map("invited_by_id") @db.Uuid
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  team      Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy User? @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  /// 같은 주소를 다시 보내면 새 행이 아니라 토큰과 만료가 갱신된다. 옛 링크는 그때 죽는다.
  @@unique([teamId, email])
  @@map("team_invites")
}

/// GitHub App 설치 1건. 사용자가 "이 계정의 이 레포들을 열어줄게" 한 단위다.
///
/// 액세스 토큰은 저장하지 않는다. 필요할 때마다 App private key 로 서명한 JWT 로
/// 1시간짜리 설치 토큰을 발급받는다 — 유출 면적이 훨씬 작다.
model GithubInstallation {
  /// GitHub 이 발급한 설치 ID. 우리가 만드는 값이 아니라 GitHub 것이라 그대로 PK.
  id           BigInt    @id
  /// 설치를 처음 연결한 사람. 기록일 뿐 권한에는 쓰지 않는다(주인은 teamId).
  /// 컬럼 이름은 user_id 그대로 둔다 — 이름을 바꾸면 배포 순서에 따라 옛 코드가 깨진다.
  createdById  String?   @map("user_id") @db.Uuid
  /// 설치의 주인. 설치 ID 가 PK 라서 설치 1건은 팀 1개만 가진다.
  /// 한 번 정해지면 다시 연결해도 바뀌지 않는다(api/github/setup).
  teamId       String    @map("team_id") @db.Uuid
  /// 설치된 계정 (개인 또는 조직)
  accountLogin String    @map("account_login")
  accountId    BigInt    @map("account_id")
  /// "User" | "Organization"
  accountType  String    @map("account_type")
  /// 아래 두 값은 웹훅(`/api/github/webhook`)이 채운다. 둘 다 행을 지우지 않고
  /// 시각만 남기는데, 그래야 "어떤 프로젝트가 왜 끊겼는지"를 화면에서 설명할 수
  /// 있다. 행까지 지우면 프로젝트가 참조를 잃고 통째로 사라진다(onDelete: Cascade).
  ///
  /// GitHub 이 결제 문제 등으로 설치를 잠시 정지시킨 시각. 풀리면 다시 null 이 된다.
  suspendedAt  DateTime? @map("suspended_at")
  /// 사용자가 GitHub 에서 앱을 지운 시각. 같은 계정에 다시 설치하면 GitHub 이
  /// 설치 ID 를 새로 발급하므로, 이 행이 다시 살아나는 일은 없다.
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  /// SetNull: 연결한 사람이 계정을 지워도 팀의 설치와 그 아래 프로젝트는 남는다.
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  projects  Project[]

  @@index([createdById])
  @@index([teamId])
  @@map("github_installations")
}

/// 레포 하나 = 프로젝트 하나.
model Project {
  id  String @id @default(uuid()) @db.Uuid
  /// URL 에 노출되는 짧은 불투명 식별자 (/project/<ref>/...).
  /// 레포 이름을 쓰지 않는 이유: rename·이관되면 URL 이 깨지고, 개인/조직에
  /// 같은 이름 레포가 있으면 충돌한다.
  ref String @unique

  /// 표시용 이름. 레포 이름을 그대로 따라간다 — 따로 바꾸는 기능은 없고,
  /// 레포가 rename 되면 웹훅이 같이 고친다 (apps/web/src/lib/github/webhook.ts).
  name String

  /// GitHub 레포 숫자 ID. rename·이관돼도 이걸로 추적한다.
  /// owner/name 은 표시용 캐시라 웹훅으로 갱신될 수 있다.
  repoId        BigInt  @map("repo_id")
  repoOwner     String  @map("repo_owner")
  repoName      String  @map("repo_name")
  defaultBranch String  @map("default_branch")
  isPrivate     Boolean @default(true) @map("is_private")

  /// 온보딩 3단계에서 고른 테스트 러너. null = 아직 안 고름.
  /// 문자열로 두는 이유: enum 은 값을 늘릴 때마다 마이그레이션이 필요한데
  /// (vitest/jest → +playwright/cypress) 초기엔 자주 늘어난다.
  testFramework String? @map("test_framework")

  /// 온보딩(레포 → 러너 → AI)을 끝낸 시각. null 이면 /project/<ref>/setup 으로 되돌린다.
  /// 중간에 이탈해도 이어서 할 수 있게 만드는 값이다.
  setupCompletedAt DateTime? @map("setup_completed_at")

  // ── 실행 환경 (설정 > Runtime) ──────────────────────
  //
  // runner 가 샌드박스에서 그대로 실행하는 값이다 (docs/adr/0001-test-runtime.md).
  // null = "아직 저장한 적 없음" 이고, 읽는 쪽이 기본값으로 접는다
  // (`lib/projects/runtime.ts`). 프로젝트를 만들 때 미리 채우지 않는 이유는
  // ProjectNotificationSetting 과 같다 — 기본값을 바꾸면 기존 행을 전부 손봐야 한다.
  //
  // Node 버전과 환경 변수는 아직 없다. 전자는 레포의 .nvmrc 를 읽는 편이 낫고,
  // 후자는 평문 저장 금지라 암호화가 따로 필요하다(lib/crypto/secret.ts).

  /// 예: "pnpm install --frozen-lockfile"
  installCommand String? @map("install_command")

  /// 예: "pnpm vitest run"
  testCommand String? @map("test_command")

  /// 실행 상한(밀리초). runner 가 5분~15분으로 다시 한 번 좁힌다 —
  /// 여기 값이 그 범위를 벗어나도 샌드박스가 무한정 돌지는 않는다.
  testTimeoutMs Int? @map("test_timeout_ms")

  /// 이 레포 하나만 끊긴 시각. 설치 자체가 정지·삭제된 경우는 여기가 아니라
  /// GithubInstallation 에 적힌다 — 그쪽은 설치에 딸린 모든 프로젝트에 해당하므로
  /// 프로젝트마다 같은 값을 복사해 두면 재설치 때 전부 되돌려야 한다.
  /// 두 곳을 하나의 상태로 접어 보려면 `lib/github/connection.ts` 를 쓴다.
  disconnectedAt     DateTime? @map("disconnected_at")
  /// 왜 끊겼는지. "repo_removed"(설치에서 레포를 뺌) | "repo_deleted"(레포 자체가 사라짐).
  /// 문자열인 이유는 testFramework 와 같다 — 값이 늘 때마다 마이그레이션하지 않으려고.
  disconnectedReason String?   @map("disconnected_reason")

  /// 프로젝트를 만든 사람. 기록일 뿐 권한에는 쓰지 않는다(주인은 teamId).
  /// 컬럼 이름은 GithubInstallation.createdById 와 같은 이유로 user_id 그대로다.
  createdById    String? @map("user_id") @db.Uuid
  /// 프로젝트의 주인. 레포를 열어준 설치와 같은 팀이다.
  teamId         String @map("team_id") @db.Uuid
  installationId BigInt @map("installation_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// SetNull: 만든 사람이 계정을 지워도 팀의 프로젝트는 남는다.
  createdBy    User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  team         Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  installation GithubInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  components   Component[]

  notificationSetting ProjectNotificationSetting?
  pullRequestSurfaces PullRequestSurface[]
  pullRequestJobs     PullRequestJob[]
  pullRequestTests    PullRequestTest[]
  deliveries          NotificationDelivery[]
  webhookDeliveries   WebhookDelivery[]
  aiUsage             AiUsage[]
  chatConversations   ChatConversation[]

  /// 레포 하나는 Dante 전체에서 프로젝트 하나다(팀 모델 결정 5).
  ///
  /// 팀 단위(teamId, repoId)가 아니라 전역인 이유: 같은 레포를 두 팀이 각자 연결하면
  /// 한 PR 에 두 팀의 코멘트·체크가 따로 달린다. 함께 쓰려면 그 팀에 초대받는다.
  @@unique([repoId])
  @@index([installationId])
  @@index([teamId])
  @@map("projects")
}

/// 익스텐션 로그인 중간 단계의 1회용 code (dante-extension 결정 D-6).
///
/// 동의 화면에서 "연결"을 누르면 만들어지고, 익스텐션이 POST /api/v1/auth/token
/// 으로 토큰과 바꾸는 순간 지워진다. 토큰을 URL 에 바로 싣지 않으려고 둔 단계다.
model ExtensionAuthCode {
  /// code 원문의 SHA-256. 원문은 에디터로 가는 URL 에 한 번 실리고 저장하지 않는다.
  codeHash      String   @id @map("code_hash")
  userId        String   @map("user_id") @db.Uuid
  /// PKCE code_challenge (S256). 교환할 때 익스텐션이 보낸 verifier 로 맞춰본다.
  codeChallenge String   @map("code_challenge")
  /// "VS Code" | "Cursor" … redirect 스킴으로 정한다. 토큰으로 그대로 옮긴다.
  editor        String
  expiresAt     DateTime @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("extension_auth_codes")
}

/// 익스텐션이 /api/v1 을 부를 때 쓰는 토큰 (dante-extension 결정 D-6).
///
/// Supabase 세션을 넘기지 않는 이유: 1시간마다 갱신해야 하고, 익스텐션이
/// Supabase 에 직접 붙지 않기로 했다(결정 D-3). 대신 우리가 만든 랜덤 문자열을
/// 90일짜리로 발급하고, DB 에는 해시만 둔다 — DB 가 새도 토큰으로 못 쓴다.
///
/// 폐기는 행을 지운다. 지운 토큰으로 오는 요청은 조회에 실패해 401 이 된다.
model ExtensionToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// 토큰 원문의 SHA-256. 원문은 발급 응답으로 한 번 나가고 저장하지 않는다.
  tokenHash  String    @unique @map("token_hash")
  /// "VS Code" | "Cursor" … 설정 화면의 "연결된 에디터" 목록에 보여준다.
  editor     String
  /// 마지막으로 API 를 부른 시각. 요청마다 쓰지 않고 1분 간격으로만 갱신한다.
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("extension_tokens")
}

/// 레포에서 뽑아낸 컴포넌트 하나. ts-morph 가 채운다.
model Component {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid

  /// 레포 루트 기준 경로. 예: "src/components/Button.tsx"
  /// 레포를 클론한 뒤 이 경로로 파일을 찾으므로 runner 도 그대로 쓴다.
  filePath String @map("file_path")

  /// export 이름. default export 는 "default".
  /// 한 파일에 컴포넌트가 여러 개일 수 있어 경로만으로는 식별되지 않는다.
  exportName String @map("export_name")

  /// 화면에 보여줄 이름. 보통 exportName 과 같지만 default export 는 다르다.
  name String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testFiles TestFile[]

  @@unique([projectId, filePath, exportName])
  @@map("components")
}

/// 컴포넌트 하나에 대응하는 테스트 파일.
///
/// 내용은 여기 없고 TestFileVersion 에 있다. 이 행은 "무엇에 대한 테스트이고
/// 레포 어디에 놓이는가"만 들고, 내용은 고칠 때마다 새 행으로 쌓인다.
model TestFile {
  id          String @id @default(uuid()) @db.Uuid
  componentId String @map("component_id") @db.Uuid

  /// 레포 루트 기준 경로. 예: "src/components/Button.test.tsx"
  path String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  component Component         @relation(fields: [componentId], references: [id], onDelete: Cascade)
  versions  TestFileVersion[]

  /// 컴포넌트당 테스트 파일 하나. 여러 개가 필요해지면 이 제약을 푼다.
  @@unique([componentId])
  @@map("test_files")
}

/// 테스트 파일의 한 버전. AI 가 만들거나 사용자가 고칠 때마다 쌓인다.
///
/// 덮어쓰지 않고 쌓는 이유: 화면에서 이력을 보여주고(date-fns 날짜 그룹핑),
/// Monaco diff 로 버전 간 차이를 보여주기 때문이다. 실행 결과(TestRun)도
/// "어느 버전을 돌린 결과인지"에 붙어야 의미가 있다.
model TestFileVersion {
  id         String @id @default(uuid()) @db.Uuid
  testFileId String @map("test_file_id") @db.Uuid

  /// 파일 전체 내용. diff 는 저장하지 않고 화면에서 계산한다.
  /// runner 는 이 값을 그대로 샌드박스에 써 넣는다.
  content String

  /// 1 부터 증가. 화면에 "v3" 처럼 보여준다.
  version Int

  /// "ai" | "user" | "repo" — 누가 만든 버전인지. "repo" 는 레포에 있던 테스트를 폴더 보기가 가져온 것.
  /// 문자열인 이유는 Project.testFramework 와 같다(값이 늘 때 마이그레이션 회피).
  source String

  /// 한 번의 프롬프트로 여러 파일을 배치 생성하면 같은 batchId 를 공유한다(최대 3).
  /// 사이드바가 같은 배치의 세션들을 묶어 보여주는 데 쓴다. 단건 생성이면 null.
  batchId String? @map("batch_id") @db.Uuid

  /// 사용자가 이 결과에 남긴 피드백. "up" | "down" | null. 품질 개선 신호로만 모은다.
  feedback String?

  createdAt DateTime @default(now()) @map("created_at")

  testFile   TestFile        @relation(fields: [testFileId], references: [id], onDelete: Cascade)
  runs       TestRun[]
  chatThread TestChatThread?

  @@unique([testFileId, version])
  @@map("test_file_versions")
}

/// 추천 세션(= TestFileVersion) 하나의 대화. 전체 메시지를 JSON 배열로 통째 저장한다.
///
/// 메시지당 행이 아니라 JSON 한 덩이인 이유: 화면(FollowUp)이 이미 메시지 배열을 통으로
/// 다루고 순서·클라이언트 생성 id 를 그대로 쓰면 된다. 조회도 "이 세션의 대화" 한 번뿐이라
/// 행별로 쪼갤 이득이 없다. 세션이 지워지면 대화도 함께 지운다(Cascade).
model TestChatThread {
  testFileVersionId String @id @map("test_file_version_id") @db.Uuid

  /// [{ id, role: "user" | "assistant", text }] 형태의 메시지 배열.
  messages Json

  updatedAt DateTime @updatedAt @map("updated_at")

  testFileVersion TestFileVersion @relation(fields: [testFileVersionId], references: [id], onDelete: Cascade)

  @@map("test_chat_threads")
}

/// 테스트 실행 1건. runner 가 만들고 갱신한다 (실행 환경은 ADR-0001).
model TestRun {
  id                String @id @default(uuid()) @db.Uuid
  testFileVersionId String @map("test_file_version_id") @db.Uuid

  /// "queued" | "running" | "passed" | "failed" | "error"
  ///
  /// failed 와 error 를 나누는 이유: failed 는 테스트가 정상적으로 돌고 떨어진
  /// 것(사용자가 고칠 거리)이고, error 는 설치 실패·타임아웃처럼 실행 자체가
  /// 안 된 것(우리가 볼 거리)이다. 화면에서 다르게 보여줘야 한다.
  status String @default("queued")

  /// 테스트 프로세스의 종료 코드. 실행조차 못 했으면 null.
  exitCode Int? @map("exit_code")

  /// stdout + stderr 합본. 사람이 읽을 로그라 구조화하지 않는다.
  logs String?

  /// status 가 "error" 일 때 화면에 한 줄로 띄울 사유.
  errorMessage String? @map("error_message")

  /// 샌드박스가 실제로 뜬 시각 ~ 끝난 시각. queued 로 머물러 있으면 둘 다 null.
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  testFileVersion TestFileVersion @relation(fields: [testFileVersionId], references: [id], onDelete: Cascade)

  /// "이 버전의 최근 실행" 을 자주 뽑는다.
  @@index([testFileVersionId, createdAt])
  @@map("test_runs")
}

/// 팀에 붙인 Slack 워크스페이스 (apps/web/src/lib/slack/). 팀당 하나.
///
/// 팀에 다는 이유는 GitHub 설치와 같다 — 레포를 다섯 개 연결한 팀이 워크스페이스를
/// 다섯 번 붙일 이유가 없다. 어느 채널로 보낼지는 프로젝트 알림 설정이 정한다.
/// 팀당 하나로 묶은 이유: 프로젝트 하나는 채널 하나로 시작한다(docs/notifications-slack.md
/// 범위 밖). 다른 워크스페이스로 다시 연결하면 이 행을 덮어쓴다.
model SlackInstallation {
  id     String @id @default(uuid()) @db.Uuid
  teamId String @unique @map("team_id") @db.Uuid

  /// Slack 쪽 워크스페이스 id ("T0123"). 이름은 바뀔 수 있어 표시용으로만 캐시한다.
  slackTeamId       String   @map("slack_team_id")
  slackTeamName     String   @map("slack_team_name")
  botUserId         String   @map("bot_user_id")
  /// xoxb- 토큰. 평문으로 두지 않는다 (lib/crypto/secret.ts).
  encryptedBotToken String   @map("encrypted_bot_token")
  /// 승인받은 scope. 나중에 scope 를 늘리면 다시 승인받아야 하는지 여기서 판단한다.
  scopes            String[]

  /// 연결한 사람. 탈퇴해도 연결은 팀에 남는다.
  installedById String?   @map("installed_by_id") @db.Uuid
  /// token_revoked / account_inactive 를 만난 시각. null 이면 살아 있다.
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  team        Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  installedBy User? @relation(fields: [installedById], references: [id], onDelete: SetNull)

  @@map("slack_installations")
}

/// 프로젝트당 1행. 알림을 "언제, 어디로, 어떻게" 보낼지의 설정값.
///
/// Slack·Discord·Email 이 붙을 것을 전제로 테이블 하나에 모은다. 채널마다 테이블을
/// 나누면 "이 프로젝트의 알림 설정"을 읽는 데 조인이 늘고, 스누즈처럼 채널을
/// 가로지르는 값이 어디 붙어야 할지 애매해진다. 지금은 GitHub·Discord·Slack 열이 있다.
///
/// 행이 없으면 "아직 한 번도 저장하지 않음"이다. 읽는 쪽은 없을 때 기본값을 쓴다
/// (`lib/notifications/settings.ts`). 프로젝트를 만들 때 미리 넣지 않는 이유는,
/// 기본값을 바꿨을 때 이미 만들어진 행 전부를 손봐야 하기 때문이다.
model ProjectNotificationSetting {
  projectId String @id @map("project_id") @db.Uuid

  // ── GitHub PR 코멘트 ────────────────────────────────
  prCommentEnabled        Boolean @default(true) @map("pr_comment_enabled")
  /// "sticky"(코멘트 하나를 계속 고쳐 씀) | "append"(푸시마다 새 코멘트).
  /// enum 대신 문자열인 이유는 Project.testFramework 와 같다 — 값이 늘 때마다
  /// 마이그레이션하지 않으려고.
  prCommentMode           String  @default("sticky") @map("pr_comment_mode")
  /// 변경된 컴포넌트가 없으면 아무것도 남기지 않는다. 문서만 고친 PR 마다
  /// "0 tests" 코멘트가 붙으면 사람들이 봇을 뮤트한다.
  prCommentSkipUnchanged  Boolean @default(true) @map("pr_comment_skip_unchanged")
  /// 전부 통과하면 상세를 <details> 로 접어서 한 줄로 보이게 한다.
  prCommentCollapseOnPass Boolean @default(true) @map("pr_comment_collapse_on_pass")
  /// 표시 항목 토글 묶음. 항목이 늘어도 마이그레이션이 필요 없게 JSON 으로 둔다.
  /// 모양은 lib/notifications/settings.ts 의 CommentFields.
  prCommentFields         Json    @map("pr_comment_fields")
  /// 코멘트 언어 "en" | "ko". 모양과 해석은 Discord 와 같다(lib/notifications/discord.ts 의 DiscordLocale).
  prCommentLocale         String  @default("en") @map("pr_comment_locale")
  /// 실패 목록에 몇 개까지 적을지. 나머지는 "…and N more" 로 접는다.
  prCommentFailedLimit    Int     @default(10) @map("pr_comment_failed_limit")

  // ── GitHub Check Run ───────────────────────────────
  checkRunEnabled  Boolean @default(true) @map("check_run_enabled")
  /// 켜면 실패를 conclusion=failure 로, 끄면 neutral 로 보고한다.
  /// 우리가 머지를 직접 막지는 못한다 — 레포의 branch protection 에서 `dante` 를
  /// required check 로 걸어야 실제로 막힌다. 화면에서 그 사실을 같이 알린다.
  checkRunBlocking Boolean @default(false) @map("check_run_blocking")

  // ── 적용 범위 ───────────────────────────────────────
  /// base 브랜치 패턴 (`release/*` 같은 glob 한 단계). 빈 배열 = 기본 브랜치만.
  branchFilters String[]  @default([]) @map("branch_filters")
  skipDraftPr   Boolean   @default(true) @map("skip_draft_pr")
  /// 이 시각까지 GitHub 에 아무것도 쓰지 않는다. null = 스누즈 아님.
  /// 스누즈 중에도 분석은 계속 돌린다 — 분석까지 멈추면 해제한 뒤 이력이 비어 있다.
  snoozedUntil  DateTime? @map("snoozed_until")

  // ── Discord ────────────────────────────────────────
  // Slack 과 달리 OAuth 가 없다. 채널의 웹훅 URL 하나가 연결의 전부다.
  discordEnabled             Boolean @default(false) @map("discord_enabled")
  /// 웹훅 URL. URL 을 가진 사람은 누구나 그 채널에 글을 쓸 수 있어 비밀값으로 다룬다
  /// (lib/crypto/secret.ts). null = 아직 붙이지 않음.
  encryptedDiscordWebhookUrl String? @map("encrypted_discord_webhook_url")
  /// { failed, recovered, passed, cannotFinish }. null 이면 기본값
  /// (lib/notifications/discord.ts 의 DEFAULT_DISCORD_EVENTS).
  discordEvents              Json?   @map("discord_events")
  /// 메시지 언어 "en" | "ko". 문자열인 이유는 prCommentMode 와 같다.
  discordLocale              String  @default("en") @map("discord_locale")

  // ── Slack ──────────────────────────────────────────
  // 워크스페이스는 팀에 붙는다(SlackInstallation). 여기는 이 프로젝트가 어느 채널로
  // 무엇을 보낼지만 적는다 (docs/notifications-slack.md §2).
  slackEnabled     Boolean @default(false) @map("slack_enabled")
  /// 채널 id ("C0123"). 이름은 바뀌므로 표시용으로만 캐시한다.
  slackChannelId   String? @map("slack_channel_id")
  slackChannelName String? @map("slack_channel_name")
  /// 어떤 결과를 보낼지. 모양은 lib/notifications/settings.ts 의 SlackEvents.
  /// prCommentFields 와 같은 이유로 JSON 이고, 빈 객체면 기본값을 쓴다.
  slackEvents      Json    @default("{}") @map("slack_events")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_notification_settings")
}

/// PR 하나에 우리가 만들어 둔 코멘트 / 체크의 GitHub 쪽 ID.
///
/// sticky 코멘트를 매번 코멘트 목록에서 찾지 않으려는 캐시다. 사람이 코멘트를
/// 지웠으면 이 ID 로 수정하는 순간 404 가 나고, 그때 본문 마커로 다시 찾는다
/// (`lib/github/pull-request.ts`). 즉 여기 값이 틀려도 복구되는 캐시지
/// 진실의 출처가 아니다.
model PullRequestSurface {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  prNumber  Int    @map("pr_number")

  commentId      BigInt? @map("comment_id")
  checkRunId     BigInt? @map("check_run_id")
  /// 마지막으로 보고한 결과 ("success" | "failure" | "neutral" …).
  /// "실패 → 실패 재알림 안 함" 판정에 쓴다.
  lastConclusion String? @map("last_conclusion")

  /// Discord 에 마지막으로 보낸 메시지와 그 결과("failed" | "passed" | "error").
  /// 같은 결과가 반복되면 이 메시지를 고치고, 결과가 바뀌면 새로 보낸다.
  /// lastConclusion 을 같이 쓰지 않는 이유: 체크를 끈 프로젝트에서는 그 값이 갱신되지 않는다.
  discordMessageId String? @map("discord_message_id")
  discordOutcome   String? @map("discord_outcome")

  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, prNumber])
  @@map("pull_request_surfaces")
}

/// PR 한 커밋(head SHA)을 처리하는 작업 (apps/web/src/lib/notifications/pull-request-job.ts).
///
/// 웹훅은 이 행을 적고 바로 응답하고, 실제 처리는 응답 뒤에 한다. 응답 뒤의 일은
/// 함수가 죽으면 자동 재시도가 없어서, 어디까지 갔는지를 여기에 남긴다.
model PullRequestJob {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  prNumber  Int    @map("pr_number")
  headSha   String @map("head_sha")

  /// "queued" | "running"(생성) | "awaiting_run"(생성 끝, 샌드박스 차례 기다림) | "testing"(샌드박스 실행)
  /// | "done" | "failed" | "superseded"(처리 중 새 커밋이 옴).
  /// 문자열인 이유는 Project.testFramework 와 같다. 실행은 팀마다 testing 하나만 둔다
  /// (apps/web/src/lib/notifications/test-run-queue.ts, docs/adr/0002-run-sandbox-from-web.md).
  status    String
  /// failed 일 때의 에러 원문.
  error     String?
  /// 같은 커밋을 몇 번 돌렸는지. 배달 재시도·Re-run 이 올릴 때마다 는다.
  attempts  Int     @default(0)
  /// 마지막 실행의 runner 응답 중 로그를 뺀 부분(status·report·errorMessage·시각).
  /// PR preview 화면이 읽는다. 실행 전에 끝났으면 null.
  runResult Json?   @map("run_result")
  /// 마지막 실행 로그. packages/sandbox 가 200k 자로 자른 원문이다.
  runLogs   String? @map("run_logs")
  /// 생성이 실행에 넘기는 값(PR 정보·컴포넌트·생성 결과 요약). 실행은 다른 함수에서 돌아서
  /// 생성 쪽 메모리를 못 본다. 모양은 apps/web/src/lib/notifications/test-run-rules.ts 의 RunInput.
  runInput     Json?     @map("run_input")
  /// testing 이 된 시각. 함수가 죽어 testing 으로 남은 작업을 가려내는 데 쓴다.
  runStartedAt DateTime? @map("run_started_at")

  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  project Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tests   PullRequestTest[]

  @@unique([projectId, prNumber, headSha])
  @@index([projectId, prNumber, createdAt])
  /// 실행 차례를 정할 때 "testing·awaiting_run 인 작업" 을 찾는다. 끝난 작업이 대부분이라 상태로 좁힌다.
  @@index([status])
  @@map("pull_request_jobs")
}

/// PR 작업에서 만든 테스트 파일 하나 (apps/web/src/lib/notifications/pr-test-generation.ts).
///
/// TestFile 과 섞지 않는 이유: 대시보드·추천은 TestFile 을 기본 브랜치의 테스트로 읽는다.
/// PR 에서 만든 테스트는 머지 전 커밋 기준이라 거기 섞이면 아직 없는 테스트가 집계된다.
model PullRequestTest {
  id        String   @id @default(uuid()) @db.Uuid
  jobId     String   @map("job_id") @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  /// 테스트를 만든 원본 컴포넌트 파일
  filePath  String   @map("file_path")
  testPath  String   @map("test_path")
  code      String
  /// 만들 때 쓴 러너. 프로젝트가 고르지 않았으면 null
  framework String?
  createdAt DateTime @default(now()) @map("created_at")

  job     PullRequestJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([jobId, testPath])
  @@index([projectId])
  @@map("pull_request_tests")
}

/// 전달 로그. "왜 코멘트가 안 달렸지"를 우리 서버 로그를 뒤지지 않고 답하려고 남긴다.
/// 30 일 보존 (정리는 별도 배치).
model NotificationDelivery {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  /// "github_comment" | "github_check" | "discord" | "slack" | (나중에) "email"
  surface   String
  prNumber  Int?    @map("pr_number")
  /// "ok" | "skipped" | "failed"
  status    String
  /// skipped 사유 또는 에러 원문. GitHub 이 준 메시지를 그대로 남긴다 —
  /// "403 Resource not accessible by integration" 은 그 자체가 안내문이다.
  detail    String?

  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("notification_deliveries")
}

/// GitHub App 웹훅 배달 로그. 대시보드 활동 집계에 쓰며 30 일 보존한다.
model WebhookDelivery {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  /// GitHub 의 X-GitHub-Event 값 (예: "pull_request", "check_run").
  event     String
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("webhook_deliveries")
}

/// AI 호출 1건의 사용량.
///
/// BYOK 를 걷어내면서 원가 부담 주체가 사용자에서 Dante 로 넘어왔다. 누가 얼마를
/// 썼는지 우리가 모르면 청구서를 설명할 수도, 한도를 걸 수도 없다. 그 근거가 이 표다.
///
/// 요청 1건 = 1행. 집계 테이블을 따로 두지 않는 이유: 지금 규모에서는 인덱스 하나로
/// 충분하고, 집계를 미리 접어두면 "이번 달" 경계나 환불 같은 걸 나중에 다시 못 편다.
model AiUsage {
  id        String  @id @default(uuid()) @db.Uuid
  /// 한도가 붙는 주체. 레포를 몇 개 연결하든 한 사람이 쓴 총량이 청구서에 맞닿는다.
  userId    String  @map("user_id") @db.Uuid
  /// 어느 프로젝트 맥락이었는지. 프로젝트 없이 부르는 자리가 생길 수 있어 nullable.
  projectId String? @map("project_id") @db.Uuid

  /// 어디서 불렀는지. "chat" | (나중에) "generate" 등.
  /// 문자열인 이유는 testFramework 와 같다 — 값이 늘 때마다 마이그레이션하지 않으려고.
  surface String

  /// 부른 모델 id 그대로. 단가표가 바뀌어도 "그때 무엇을 불렀나"는 남아야
  /// 과거 원가를 다시 계산할 수 있다.
  model String

  /// 프로바이더가 준 값. AI SDK 의 LanguageModelUsage 는 전부 number | undefined 라
  /// 실제로 모를 수 있다. 0 으로 뭉개면 "안 썼다"와 "모른다"가 같아지므로 null 을 남긴다.
  inputTokens       Int? @map("input_tokens")
  /// 캐시에서 읽은 입력 토큰. 단가가 1/10 이라 따로 세지 않으면 원가가 부풀려진다.
  cachedInputTokens Int? @map("cached_input_tokens")
  outputTokens      Int? @map("output_tokens")

  /// 계산한 원가(USD). 토큰을 모르면 이것도 null 이다.
  /// Decimal 인 이유: 달러를 Float 로 누적하면 틀린다. 한도 판정에 쓰는 값이라
  /// 반올림 오차가 "막혔는데 왜 막혔는지 설명이 안 되는" 상황을 만든다.
  costUsd Decimal? @map("cost_usd") @db.Decimal(12, 6)

  /// 호출이 끝나 실제 사용량으로 바뀐 시각. null 이면 아직 예약 중이다 — 행은 호출 전에
  /// 만들어지고(budget.ts reserveAiBudget) 그동안 costUsd 에는 그 호출의 원가 상한이 들어
  /// 있다. 끝내 채워지지 않으면(서버가 도중에 죽음) 상한 그대로 한도에 남는다.
  settledAt DateTime? @map("settled_at")

  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  /// "이 사용자가 이번 달 얼마 썼나" 가 가장 잦은 질문이다.
  @@index([userId, createdAt])
  @@map("ai_usage")
}

/// 폴더 보기 AI 채팅의 대화 하나.
///
/// 브라우저(localStorage)에 두던 기록을 서버로 옮겼다 — 기기를 옮기면 사라지고, 용량을
/// 넘으면 조용히 저장이 실패했다. 보는 사람은 만든 본인뿐이다(팀원에게 공유하지 않는다).
/// 읽을 때는 userId 에 더해 프로젝트 접근 권한도 본다: 팀에서 빠진 사람이 예전 대화로
/// 그 레포 코드를 다시 보지 못하게.
///
/// 보유 기간: 사용자가 지우거나 탈퇴할 때까지. 자동 삭제 작업은 없다(개인정보처리방침과 같은 값).
model ChatConversation {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  projectId String @map("project_id") @db.Uuid

  /// 목록에 보이는 제목(첫 질문을 한 줄로 접은 것). 질문 내용 그대로라 본문처럼 암호문으로 둔다.
  title String

  /// 마지막 답에서 모델이 알려준 입력+출력 토큰. 다음 질문이 이만큼을 들고 간다.
  /// 화면의 "컨텍스트 %"와 서버의 대화 상한(409)이 이 값을 본다.
  contextTokens Int @default(0) @map("context_tokens")

  /// 이 대화가 붙은 파일(레포 루트 기준). 대화는 파일마다 따로다 — 다른 파일에서 이어 쓰지 않는다.
  /// 파일 없이 시작한 대화(예전 데이터)는 null 이고 어느 파일 목록에도 나오지 않는다.
  filePath String? @map("file_path")

  createdAt DateTime @default(now()) @map("created_at")
  /// 목록 정렬 기준. 메시지를 저장할 때 같이 갱신된다.
  updatedAt DateTime @updatedAt @map("updated_at")

  /// 탈퇴·프로젝트 삭제 시 대화도 같이 지운다 — 보유 기간이 "탈퇴할 때까지"라서.
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  /// "이 파일에서 내 최근 대화" 목록을 updatedAt 커서로 넘긴다.
  @@index([userId, projectId, filePath, updatedAt])
  @@map("chat_conversations")
}

/// 대화 안의 메시지 하나. 질문과 답은 정상 완료된 뒤에 한 쌍으로만 저장한다
/// (중단한 답은 질문까지 남기지 않는다).
model ChatMessage {
  id             String @id @default(uuid()) @db.Uuid
  conversationId String @map("conversation_id") @db.Uuid

  /// "user" | "assistant". 문자열인 이유는 testFramework 와 같다.
  role String

  /// 본문. AES-256-GCM 암호문(lib/crypto/secret.ts) — 사용자가 코드나 비밀값을 붙여 넣는다.
  /// DB 에서 내용 검색은 못 하게 되지만 그런 기능은 없다.
  content String

  /// 질문할 때 열어 둔 파일 경로. 본문은 저장하지 않는다 — 레포에서 다시 읽을 수 있고,
  /// 저장하면 레포 코드 사본이 DB 에 쌓인다.
  filePath String? @map("file_path")

  createdAt DateTime @default(now()) @map("created_at")

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}
