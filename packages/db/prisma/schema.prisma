// 데이터 모델. "GitHub 레포 연결" + "테스트 생성·실행" 두 갈래다.
//
// 뒤쪽(Component → TestFile → TestFileVersion → TestRun)은 아직 생성 기능이
// 없는 상태에서 runner 를 붙이려고 먼저 넣은 것이다. 실제 생성 로직이 들어오면
// 필드가 늘 수 있다. 지금은 runner 가 "무엇을 어디서 돌릴지" 알아내는 데
// 필요한 최소한만 있다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // 풀러(6543) + ?pgbouncer=true&connection_limit=1
  directUrl = env("DIRECT_URL") // 직접(5432), migrate 전용
}

/// Supabase 의 auth.users 를 public 스키마에서 참조하기 위한 미러.
///
/// auth.users 에 직접 외래키를 걸지 않는 이유:
///   - auth 스키마는 Supabase 가 관리한다. 우리 마이그레이션이 건드리면 충돌한다.
///   - Prisma 는 public 스키마만 본다(AGENTS.md).
/// 그래서 id 에 auth.users.id 와 같은 UUID 를 넣고, 채우는 건 앱 코드가 한다
/// (로그인 후 첫 요청에서 upsert).
model User {
  /// = auth.users.id
  id          String   @id @db.Uuid
  email       String?
  /// GitHub 로그인 핸들. 설치가 이 사용자 것인지 대조할 때 쓴다.
  githubLogin String?  @map("github_login")
  /// = GitHub 사용자 숫자 ID (auth 의 provider_id)
  githubId    BigInt?  @map("github_id")
  /// 프로바이더가 준 프로필 이미지 URL (GitHub avatar_url / Google picture).
  /// 헤더는 로그인 세션의 값을 그대로 쓰지만, 세션 없이 사용자를 그려야 하는
  /// 자리(다른 사람이 보는 화면 등)를 위해 로그인마다 여기에 복사해둔다.
  avatarUrl   String?  @map("avatar_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  installations      GithubInstallation[]
  projects           Project[]
  apiKeys            UserApiKey[]
  extensionAuthCodes ExtensionAuthCode[]
  extensionTokens    ExtensionToken[]

  @@map("users")
}

/// GitHub App 설치 1건. 사용자가 "이 계정의 이 레포들을 열어줄게" 한 단위다.
///
/// 액세스 토큰은 저장하지 않는다. 필요할 때마다 App private key 로 서명한 JWT 로
/// 1시간짜리 설치 토큰을 발급받는다 — 유출 면적이 훨씬 작다.
model GithubInstallation {
  /// GitHub 이 발급한 설치 ID. 우리가 만드는 값이 아니라 GitHub 것이라 그대로 PK.
  id           BigInt    @id
  userId       String    @map("user_id") @db.Uuid
  /// 설치된 계정 (개인 또는 조직)
  accountLogin String    @map("account_login")
  accountId    BigInt    @map("account_id")
  /// "User" | "Organization"
  accountType  String    @map("account_type")
  /// 아래 두 값은 웹훅(`/api/github/webhook`)이 채운다. 둘 다 행을 지우지 않고
  /// 시각만 남기는데, 그래야 "어떤 프로젝트가 왜 끊겼는지"를 화면에서 설명할 수
  /// 있다. 행까지 지우면 프로젝트가 참조를 잃고 통째로 사라진다(onDelete: Cascade).
  ///
  /// GitHub 이 결제 문제 등으로 설치를 잠시 정지시킨 시각. 풀리면 다시 null 이 된다.
  suspendedAt  DateTime? @map("suspended_at")
  /// 사용자가 GitHub 에서 앱을 지운 시각. 같은 계정에 다시 설치하면 GitHub 이
  /// 설치 ID 를 새로 발급하므로, 이 행이 다시 살아나는 일은 없다.
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects Project[]

  @@index([userId])
  @@map("github_installations")
}

/// 레포 하나 = 프로젝트 하나.
model Project {
  id  String @id @default(uuid()) @db.Uuid
  /// URL 에 노출되는 짧은 불투명 식별자 (/project/<ref>/...).
  /// 레포 이름을 쓰지 않는 이유: rename·이관되면 URL 이 깨지고, 개인/조직에
  /// 같은 이름 레포가 있으면 충돌한다.
  ref String @unique

  /// 표시용 이름. 레포 이름을 그대로 따라간다 — 따로 바꾸는 기능은 없고,
  /// 레포가 rename 되면 웹훅이 같이 고친다 (apps/web/src/lib/github/webhook.ts).
  name String

  /// GitHub 레포 숫자 ID. rename·이관돼도 이걸로 추적한다.
  /// owner/name 은 표시용 캐시라 웹훅으로 갱신될 수 있다.
  repoId        BigInt  @map("repo_id")
  repoOwner     String  @map("repo_owner")
  repoName      String  @map("repo_name")
  defaultBranch String  @map("default_branch")
  isPrivate     Boolean @default(true) @map("is_private")

  /// 온보딩 3단계에서 고른 테스트 러너. null = 아직 안 고름.
  /// 문자열로 두는 이유: enum 은 값을 늘릴 때마다 마이그레이션이 필요한데
  /// (vitest/jest → +playwright/cypress) 초기엔 자주 늘어난다.
  testFramework String? @map("test_framework")

  /// 온보딩(레포 → 러너 → API 키)을 끝낸 시각. null 이면 /project/<ref>/setup 으로 되돌린다.
  /// 중간에 이탈해도 이어서 할 수 있게 만드는 값이다.
  setupCompletedAt DateTime? @map("setup_completed_at")

  // ── 실행 환경 (설정 > Runtime) ──────────────────────
  //
  // runner 가 샌드박스에서 그대로 실행하는 값이다 (docs/adr/0001-test-runtime.md).
  // null = "아직 저장한 적 없음" 이고, 읽는 쪽이 기본값으로 접는다
  // (`lib/projects/runtime.ts`). 프로젝트를 만들 때 미리 채우지 않는 이유는
  // ProjectNotificationSetting 과 같다 — 기본값을 바꾸면 기존 행을 전부 손봐야 한다.
  //
  // Node 버전과 환경 변수는 아직 없다. 전자는 레포의 .nvmrc 를 읽는 편이 낫고,
  // 후자는 평문 저장 금지라 UserApiKey 처럼 암호화가 따로 필요하다.

  /// 예: "pnpm install --frozen-lockfile"
  installCommand String? @map("install_command")

  /// 예: "pnpm vitest run"
  testCommand String? @map("test_command")

  /// 실행 상한(밀리초). runner 가 5분~15분으로 다시 한 번 좁힌다 —
  /// 여기 값이 그 범위를 벗어나도 샌드박스가 무한정 돌지는 않는다.
  testTimeoutMs Int? @map("test_timeout_ms")

  /// 이 레포 하나만 끊긴 시각. 설치 자체가 정지·삭제된 경우는 여기가 아니라
  /// GithubInstallation 에 적힌다 — 그쪽은 설치에 딸린 모든 프로젝트에 해당하므로
  /// 프로젝트마다 같은 값을 복사해 두면 재설치 때 전부 되돌려야 한다.
  /// 두 곳을 하나의 상태로 접어 보려면 `lib/github/connection.ts` 를 쓴다.
  disconnectedAt     DateTime? @map("disconnected_at")
  /// 왜 끊겼는지. "repo_removed"(설치에서 레포를 뺌) | "repo_deleted"(레포 자체가 사라짐).
  /// 문자열인 이유는 testFramework 와 같다 — 값이 늘 때마다 마이그레이션하지 않으려고.
  disconnectedReason String?   @map("disconnected_reason")

  userId         String @map("user_id") @db.Uuid
  installationId BigInt @map("installation_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  installation GithubInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  components   Component[]

  notificationSetting ProjectNotificationSetting?
  pullRequestSurfaces PullRequestSurface[]
  deliveries          NotificationDelivery[]

  /// 같은 레포를 같은 사용자가 두 번 연결하지 못하게 막는다.
  /// TODO(팀 PR): 소유 주체가 User → Team 으로 바뀌면 이 제약도 teamId 기준으로 옮긴다.
  @@unique([userId, repoId])
  @@index([installationId])
  @@map("projects")
}

/// 사용자가 직접 넣는 LLM API 키 (온보딩 4단계).
///
/// 평문 저장 금지(AGENTS.md). Node 내장 crypto 로 AES-256-GCM 암호화해서 넣고,
/// 복호화는 서버에서만 한다. 화면에는 끝 4자리(hint)만 보여준다.
model UserApiKey {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @map("user_id") @db.Uuid
  /// "anthropic" | "openai" | "google" — AI SDK 프로바이더 이름과 맞춘다.
  provider String

  /// AES-256-GCM 결과. iv·authTag 를 같이 담는다.
  encryptedKey String @map("encrypted_key")
  /// 화면 표시용 마지막 4자리. 복호화 없이 "어떤 키였더라"를 알 수 있게.
  lastFour     String @map("last_four")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 프로바이더당 키 하나. 바꾸면 덮어쓴다.
  @@unique([userId, provider])
  @@map("user_api_keys")
}

/// 익스텐션 로그인 중간 단계의 1회용 code (dante-extension 결정 D-6).
///
/// 동의 화면에서 "연결"을 누르면 만들어지고, 익스텐션이 POST /api/v1/auth/token
/// 으로 토큰과 바꾸는 순간 지워진다. 토큰을 URL 에 바로 싣지 않으려고 둔 단계다.
model ExtensionAuthCode {
  /// code 원문의 SHA-256. 원문은 에디터로 가는 URL 에 한 번 실리고 저장하지 않는다.
  codeHash      String   @id @map("code_hash")
  userId        String   @map("user_id") @db.Uuid
  /// PKCE code_challenge (S256). 교환할 때 익스텐션이 보낸 verifier 로 맞춰본다.
  codeChallenge String   @map("code_challenge")
  /// "VS Code" | "Cursor" … redirect 스킴으로 정한다. 토큰으로 그대로 옮긴다.
  editor        String
  expiresAt     DateTime @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("extension_auth_codes")
}

/// 익스텐션이 /api/v1 을 부를 때 쓰는 토큰 (dante-extension 결정 D-6).
///
/// Supabase 세션을 넘기지 않는 이유: 1시간마다 갱신해야 하고, 익스텐션이
/// Supabase 에 직접 붙지 않기로 했다(결정 D-3). 대신 우리가 만든 랜덤 문자열을
/// 90일짜리로 발급하고, DB 에는 해시만 둔다 — DB 가 새도 토큰으로 못 쓴다.
///
/// 폐기는 행을 지운다. 지운 토큰으로 오는 요청은 조회에 실패해 401 이 된다.
model ExtensionToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// 토큰 원문의 SHA-256. 원문은 발급 응답으로 한 번 나가고 저장하지 않는다.
  tokenHash  String    @unique @map("token_hash")
  /// "VS Code" | "Cursor" … 설정 화면의 "연결된 에디터" 목록에 보여준다.
  editor     String
  /// 마지막으로 API 를 부른 시각. 요청마다 쓰지 않고 1분 간격으로만 갱신한다.
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("extension_tokens")
}

/// 레포에서 뽑아낸 컴포넌트 하나. ts-morph 가 채운다.
model Component {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid

  /// 레포 루트 기준 경로. 예: "src/components/Button.tsx"
  /// 레포를 클론한 뒤 이 경로로 파일을 찾으므로 runner 도 그대로 쓴다.
  filePath String @map("file_path")

  /// export 이름. default export 는 "default".
  /// 한 파일에 컴포넌트가 여러 개일 수 있어 경로만으로는 식별되지 않는다.
  exportName String @map("export_name")

  /// 화면에 보여줄 이름. 보통 exportName 과 같지만 default export 는 다르다.
  name String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testFiles TestFile[]

  @@unique([projectId, filePath, exportName])
  @@map("components")
}

/// 컴포넌트 하나에 대응하는 테스트 파일.
///
/// 내용은 여기 없고 TestFileVersion 에 있다. 이 행은 "무엇에 대한 테스트이고
/// 레포 어디에 놓이는가"만 들고, 내용은 고칠 때마다 새 행으로 쌓인다.
model TestFile {
  id          String @id @default(uuid()) @db.Uuid
  componentId String @map("component_id") @db.Uuid

  /// 레포 루트 기준 경로. 예: "src/components/Button.test.tsx"
  path String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  component Component         @relation(fields: [componentId], references: [id], onDelete: Cascade)
  versions  TestFileVersion[]

  /// 컴포넌트당 테스트 파일 하나. 여러 개가 필요해지면 이 제약을 푼다.
  @@unique([componentId])
  @@map("test_files")
}

/// 테스트 파일의 한 버전. AI 가 만들거나 사용자가 고칠 때마다 쌓인다.
///
/// 덮어쓰지 않고 쌓는 이유: 화면에서 이력을 보여주고(date-fns 날짜 그룹핑),
/// Monaco diff 로 버전 간 차이를 보여주기 때문이다. 실행 결과(TestRun)도
/// "어느 버전을 돌린 결과인지"에 붙어야 의미가 있다.
model TestFileVersion {
  id         String @id @default(uuid()) @db.Uuid
  testFileId String @map("test_file_id") @db.Uuid

  /// 파일 전체 내용. diff 는 저장하지 않고 화면에서 계산한다.
  /// runner 는 이 값을 그대로 샌드박스에 써 넣는다.
  content String

  /// 1 부터 증가. 화면에 "v3" 처럼 보여준다.
  version Int

  /// "ai" | "user" — 누가 만든 버전인지.
  /// 문자열인 이유는 Project.testFramework 와 같다(값이 늘 때 마이그레이션 회피).
  source String

  createdAt DateTime @default(now()) @map("created_at")

  testFile TestFile  @relation(fields: [testFileId], references: [id], onDelete: Cascade)
  runs     TestRun[]

  @@unique([testFileId, version])
  @@map("test_file_versions")
}

/// 테스트 실행 1건. runner 가 만들고 갱신한다 (실행 환경은 ADR-0001).
model TestRun {
  id                String @id @default(uuid()) @db.Uuid
  testFileVersionId String @map("test_file_version_id") @db.Uuid

  /// "queued" | "running" | "passed" | "failed" | "error"
  ///
  /// failed 와 error 를 나누는 이유: failed 는 테스트가 정상적으로 돌고 떨어진
  /// 것(사용자가 고칠 거리)이고, error 는 설치 실패·타임아웃처럼 실행 자체가
  /// 안 된 것(우리가 볼 거리)이다. 화면에서 다르게 보여줘야 한다.
  status String @default("queued")

  /// 테스트 프로세스의 종료 코드. 실행조차 못 했으면 null.
  exitCode Int? @map("exit_code")

  /// stdout + stderr 합본. 사람이 읽을 로그라 구조화하지 않는다.
  logs String?

  /// status 가 "error" 일 때 화면에 한 줄로 띄울 사유.
  errorMessage String? @map("error_message")

  /// 샌드박스가 실제로 뜬 시각 ~ 끝난 시각. queued 로 머물러 있으면 둘 다 null.
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  testFileVersion TestFileVersion @relation(fields: [testFileVersionId], references: [id], onDelete: Cascade)

  /// "이 버전의 최근 실행" 을 자주 뽑는다.
  @@index([testFileVersionId, createdAt])
  @@map("test_runs")
}

/// 프로젝트당 1행. 알림을 "언제, 어디로, 어떻게" 보낼지의 설정값.
///
/// Slack·Discord·Email 이 붙을 것을 전제로 테이블 하나에 모은다. 채널마다 테이블을
/// 나누면 "이 프로젝트의 알림 설정"을 읽는 데 조인이 늘고, 스누즈처럼 채널을
/// 가로지르는 값이 어디 붙어야 할지 애매해진다. 지금은 GitHub 열만 채운다.
///
/// 행이 없으면 "아직 한 번도 저장하지 않음"이다. 읽는 쪽은 없을 때 기본값을 쓴다
/// (`lib/notifications/settings.ts`). 프로젝트를 만들 때 미리 넣지 않는 이유는,
/// 기본값을 바꿨을 때 이미 만들어진 행 전부를 손봐야 하기 때문이다.
model ProjectNotificationSetting {
  projectId String @id @map("project_id") @db.Uuid

  // ── GitHub PR 코멘트 ────────────────────────────────
  prCommentEnabled        Boolean @default(true) @map("pr_comment_enabled")
  /// "sticky"(코멘트 하나를 계속 고쳐 씀) | "append"(푸시마다 새 코멘트).
  /// enum 대신 문자열인 이유는 Project.testFramework 와 같다 — 값이 늘 때마다
  /// 마이그레이션하지 않으려고.
  prCommentMode           String  @default("sticky") @map("pr_comment_mode")
  /// 변경된 컴포넌트가 없으면 아무것도 남기지 않는다. 문서만 고친 PR 마다
  /// "0 tests" 코멘트가 붙으면 사람들이 봇을 뮤트한다.
  prCommentSkipUnchanged  Boolean @default(true) @map("pr_comment_skip_unchanged")
  /// 전부 통과하면 상세를 <details> 로 접어서 한 줄로 보이게 한다.
  prCommentCollapseOnPass Boolean @default(true) @map("pr_comment_collapse_on_pass")
  /// 표시 항목 토글 묶음. 항목이 늘어도 마이그레이션이 필요 없게 JSON 으로 둔다.
  /// 모양은 lib/notifications/settings.ts 의 CommentFields.
  prCommentFields         Json    @map("pr_comment_fields")
  /// 실패 목록에 몇 개까지 적을지. 나머지는 "…and N more" 로 접는다.
  prCommentFailedLimit    Int     @default(10) @map("pr_comment_failed_limit")

  // ── GitHub Check Run ───────────────────────────────
  checkRunEnabled  Boolean @default(true) @map("check_run_enabled")
  /// 켜면 실패를 conclusion=failure 로, 끄면 neutral 로 보고한다.
  /// 우리가 머지를 직접 막지는 못한다 — 레포의 branch protection 에서 `dante` 를
  /// required check 로 걸어야 실제로 막힌다. 화면에서 그 사실을 같이 알린다.
  checkRunBlocking Boolean @default(false) @map("check_run_blocking")

  // ── 적용 범위 ───────────────────────────────────────
  /// base 브랜치 패턴 (`release/*` 같은 glob 한 단계). 빈 배열 = 기본 브랜치만.
  branchFilters String[]  @default([]) @map("branch_filters")
  skipDraftPr   Boolean   @default(true) @map("skip_draft_pr")
  /// 이 시각까지 GitHub 에 아무것도 쓰지 않는다. null = 스누즈 아님.
  /// 스누즈 중에도 분석은 계속 돌린다 — 분석까지 멈추면 해제한 뒤 이력이 비어 있다.
  snoozedUntil  DateTime? @map("snoozed_until")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_notification_settings")
}

/// PR 하나에 우리가 만들어 둔 코멘트 / 체크의 GitHub 쪽 ID.
///
/// sticky 코멘트를 매번 코멘트 목록에서 찾지 않으려는 캐시다. 사람이 코멘트를
/// 지웠으면 이 ID 로 수정하는 순간 404 가 나고, 그때 본문 마커로 다시 찾는다
/// (`lib/github/pull-request.ts`). 즉 여기 값이 틀려도 복구되는 캐시지
/// 진실의 출처가 아니다.
model PullRequestSurface {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  prNumber  Int    @map("pr_number")

  commentId      BigInt? @map("comment_id")
  checkRunId     BigInt? @map("check_run_id")
  /// 마지막으로 보고한 결과 ("success" | "failure" | "neutral" …).
  /// "실패 → 실패 재알림 안 함" 판정에 쓴다.
  lastConclusion String? @map("last_conclusion")

  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, prNumber])
  @@map("pull_request_surfaces")
}

/// 전달 로그. "왜 코멘트가 안 달렸지"를 우리 서버 로그를 뒤지지 않고 답하려고 남긴다.
/// 30 일 보존 (정리는 별도 배치).
model NotificationDelivery {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  /// "github_comment" | "github_check" | (나중에) "slack" | "discord" | "email"
  surface   String
  prNumber  Int?    @map("pr_number")
  /// "ok" | "skipped" | "failed"
  status    String
  /// skipped 사유 또는 에러 원문. GitHub 이 준 메시지를 그대로 남긴다 —
  /// "403 Resource not accessible by integration" 은 그 자체가 안내문이다.
  detail    String?

  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("notification_deliveries")
}
